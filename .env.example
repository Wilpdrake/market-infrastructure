# Шаблон переменных окружения. Скопируй в .env и заполни реальными значениями.
# .env НЕ коммитится (.gitignore). Никогда не пиши реальный пароль прямо в compose.
POSTGRES_USER=market
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=market
BACKEND_SECRET_KEY=replace_with_at_least_32_random_characters
FIRST_SUPERUSER_EMAIL=developer@example.com
FIRST_SUPERUSER_USERNAME=wilpdrake
FIRST_SUPERUSER_ROLE=developer
FIRST_SUPERUSER_PASSWORD=replace_with_a_strong_password
FIRST_SUPERUSER_NAME=Admin
FIRST_SUPERUSER_SURNAME=Administrator
BACKEND_CONTEXT=../market-backend
FRONTEND_CONTEXT=../market-frontend
BOT_CONTEXT=../market-bot
BOT_LOG_LEVEL=INFO
HTTPS_PORT=443
# Production only: host paths to a Cloudflare Origin Certificate and its private key.
CLOUDFLARE_ORIGIN_CERT_PATH=/etc/market/tls/cloudflare-origin.pem
CLOUDFLARE_ORIGIN_KEY_PATH=/etc/market/tls/cloudflare-origin.key

# Telegram token используется отдельным polling-ботом и опциональной backend-интеграцией.
# В production Jenkins подставляет Secret text credential `telegram-bot-token`.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_BOT_USERNAME=market_bot
TELEGRAM_WEBHOOK_SECRET=

# T-Bank internet acquiring. Keep merchant credentials in Jenkins Secret Text credentials.
TBANK_TERMINAL_KEY=replace_with_tbank_terminal_key
TBANK_PASSWORD=replace_with_tbank_password
TBANK_API_URL=https://securepay.tinkoff.ru/v2
TBANK_SUCCESS_URL=https://woodandclay.ru/checkout/return
TBANK_FAIL_URL=https://woodandclay.ru/checkout/return?payment=failed
TBANK_NOTIFICATION_URL=https://woodandclay.ru/api/v1/payments/tbank/webhook
