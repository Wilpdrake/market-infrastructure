# Шаблон переменных окружения. Скопируй в .env и заполни реальными значениями.
# .env НЕ коммитится (.gitignore). Никогда не пиши реальный пароль прямо в compose.
POSTGRES_USER=market
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=market
BACKEND_SECRET_KEY=replace_with_at_least_32_random_characters
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace_with_a_strong_password
FIRST_SUPERUSER_NAME=Admin
FIRST_SUPERUSER_SURNAME=Administrator
